{
  "name": "magnis-plugins",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "plugins/modules/*",
    "plugins/sources/*"
  ],
  "scripts": {
    "agent:install": "bun install --frozen-lockfile",
    "agent:test:backend": "bash scripts/test-connectors.sh --agent",
    "agent:test:frontend": "vitest run --config vitest.ui.config.ts",
    "agent:test:e2e": "echo 'N/A: catalog has no separate deployed E2E lane; Source journeys run in agent:test:backend'",
    "agent:verify:commit": "bun scripts/agent-verify.ts commit",
    "agent:verify:pr": "bun run check",
    "agent:verify:docs": "bun scripts/agent-verify.ts docs",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:runtime-contracts && bun run test:ui && bun run test:connectors && bun run test:scripts && bun run build:plugins",
    "typecheck": "bash scripts/typecheck-all.sh",
    "lint": "eslint \"plugins/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"apps/desktop/build/**/*.ts\" --max-warnings 0",
    "test": "vitest run && bun test apps/desktop/build/",
    "test:runtime-contracts": "bun test packages/runtime-contracts/test/",
    "test:connectors": "bash scripts/test-connectors.sh",
    "test:scripts": "bun test scripts/",
    "test:desktop-runtime": "bun test apps/desktop/build/",
    "build:plugins": "bun scripts/build-plugins.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts"
  },
  "agentStack": {
    "ci": "external",
    "ciWorkflow": ".github/workflows/ci.yml"
  },
  "patchedDependencies": {
    "telegram@2.26.22": "patches/telegram@2.26.22.patch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.1.18",
    "@tanstack/react-query": "^5.90.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.5.0",
    "lucide-react": "^0.563.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.4",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.7.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8",
    "vitest": "^4.0.18",
    "zustand": "^5.0.11"
  }
}

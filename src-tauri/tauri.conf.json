{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Magnis",
  "version": "0.1.0",
  "identifier": "com.magnis.desktop",
  "build": {
    "beforeDevCommand": "cd ../frontend && MAGNIS_BACKEND_PORT=3765 VITE_API_URL=http://localhost:5190 bun run dev -- --port 5190",
    "devUrl": "http://localhost:5190",
    "beforeBuildCommand": "bash build/bundle-embedded-pg.sh && bash build/bundle-agent.sh && bash build/bundle-secrets.sh && bash build/bundle-plugins.sh && cd ../frontend && VITE_API_URL=http://localhost:3765 bun run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Magnis",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/magnis-server",
      "binaries/agent-server"
    ],
    "resources": [
      "magnis.env",
      "plugins",
      "plugins_dist"
    ]
  }
}

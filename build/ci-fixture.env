# CI-only fixture for bundle-secrets.sh (DEC-17). NON-REAL placeholder values
# used solely to prove the bundle wiring compiles in CI. The resulting DMG is a
# CI artifact, never a shippable release. Real credentials come from the dev's
# local .env at production build time.
GOOGLE_CLIENT_ID=ci-fixture-google-client-id
GOOGLE_CLIENT_SECRET=ci-fixture-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/oauth/callback
TELEGRAM_API_ID=000000
TELEGRAM_API_HASH=ci-fixture-telegram-api-hash
ANTHROPIC_API_KEY=sk-ant-ci-fixture-not-a-real-key
DEFAULT_ENGINE=claude

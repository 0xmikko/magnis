{
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "humans"],
  "properties": {
    "task": { "type": "string", "const": "p3" },
    "humans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "accounts", "evidence_refs"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "accounts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}

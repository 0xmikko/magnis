import { spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import { readFileSync, realpathSync } from "node:fs";
import { createRequire } from "node:module";
import { dirname, join } from "node:path";
import { PassThrough } from "node:stream";

import { spyOn } from "bun:test";

import { McpClient } from "../../src/services/sources/runtime/source-host.client.js";
import type { SourceBindingResource } from "../../src/services/sources/runtime/source-runtime.types.js";
import type { SyncClock } from "../../src/utils/clock.js";
import pins from "../fixtures/telegram-fast-sync/pins.json" with { type: "json" };
import { deferred } from "./deferred.js";

/** Variables git sets for hook processes; a pinned checkout must be asked directly. */
const HOOK_GIT_VARIABLES = new Set(["GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR", "GIT_PREFIX", "GIT_OBJECT_DIRECTORY"]);

interface TlObject { getBytes(): Buffer }
interface Completion { readonly promise: Promise<undefined>; resolve(value: undefined): void }
interface Transmission { method: string; at: number; state: { request: Record<string, unknown> } }
interface VirtualClock { now(): number; advance(ms: number): void; schedule(run: () => void, delay: number): () => void }
interface SessionPool {
  admissionFor(account: string): { holdUntil: number | null; remoteFloods: number; localRefusals: number };
  getOrCreate(account: string, credentials: Record<string, unknown>): Promise<unknown>;
  evict(account: string): Promise<boolean>;
}
interface Transport {
  client: { invoke(request: TlObject): Promise<unknown> };
  connected: Promise<boolean>;
  writes: Transmission[];
  application(index: number): Promise<Transmission>;
  reply(sent: Transmission, result: TlObject): Promise<void>;
  incoming(object: TlObject): Promise<void>;
  close(): Promise<void>;
}
interface TransportModule {
  VirtualClock: new () => VirtualClock;
  setupConfig(): TlObject;
  createTransport(clock: VirtualClock, admission: unknown, normal: boolean,
    launch: (options: Record<string, unknown>, session: string) => Promise<unknown>): Promise<Transport>;
}
interface LiveModule {
  SessionPool: new (options: { clock: VirtualClock; diagnostics(): void; transport?: Record<string, unknown> }) => SessionPool;
  pool(): SessionPool;
}
interface Registry { stop(id: string): unknown }
interface DispatchModule {
  runMcpStdio(input: PassThrough, options: { authMode: boolean; registry: Registry; write(line: string): void }): Promise<void>;
}
function object(value: unknown): Record<string, unknown> {
  if (value === null || typeof value !== "object") throw new Error("Expected catalog object");
  return value as Record<string, unknown>;
}
function digest(path: string): string { return createHash("sha256").update(readFileSync(path)).digest("hex"); }

/** Caller controls the provider boundary; no Source envelope or SDK invoke is replaced. */
export class TelegramSourceProvider {
  readonly account = "telegram-fast-proof-account";
  readonly histories = new Map(Array.from({ length: 50 }, (_, index) => [101 + index, index === 0 ? 120 : index === 1 ? 70 : index === 2 ? 5 : 0]));
  readonly requests: { method: string; chat: number | null; offset: number; limit: number; at: number; returned?: number; total?: number }[] = [];
  readonly errors: string[] = [];
  readonly wire: Record<string, unknown>[] = [];
  readonly calls: { name: string; args: Record<string, unknown>; started: number; elapsed: number | null; response?: Record<string, unknown> }[] = [];
  readonly clock: SyncClock;
  readonly transport: Transport;
  readonly session: string;
  private readonly resources = new Set<() => Promise<void>>();
  private readonly ended = deferred<undefined>();
  private readonly pause = new Map<string, Completion>();
  private readonly entered = new Map<string, Completion>();
  private flood: number | null = null;
  private holdAfter = 0;
  private timeout: (() => void) | undefined;
  private restoreTimeout = (): void => undefined;
  private stopped = false;
  private readonly loop: Promise<void>;

  private constructor(readonly root: string, private readonly api: Record<string, unknown>,
    private readonly integer: (value: number) => unknown, private readonly dispatch: DispatchModule,
    private readonly RegistryType: new () => Registry, private readonly time: VirtualClock,
    private readonly pool: SessionPool, private readonly restorePool: () => void,
    transport: Transport, session: string, private readonly setupConfig: () => TlObject) {
    this.transport = transport;
    this.session = session;
    this.clock = { now: () => this.time.now(), sleep: (delay, signal) => new Promise<void>((resolve) => {
      if (signal?.aborted) { resolve(); return; }
      if (delay <= 0) { setImmediate(resolve); return; }
      const finish = (): void => { cancel(); signal?.removeEventListener("abort", finish); resolve(); };
      const cancel = this.time.schedule(finish, delay);
      signal?.addEventListener("abort", finish, { once: true });
    }) };
    this.loop = this.answerLoop().catch((error: unknown) => { this.errors.push(String(error)); });
  }

  static async open(): Promise<TelegramSourceProvider> {
    const configured = process.env["MAGNIS_TELEGRAM_SOURCE_ROOT"];
    if (!configured) throw new Error("Set MAGNIS_TELEGRAM_SOURCE_ROOT to the explicitly pinned catalog checkout");
    const root = realpathSync(configured);
    // git exports GIT_DIR and its companions to the hooks of a linked worktree;
    // inherited here, they would make `git -C <catalog>` answer for magnis-app.
    const env = Object.fromEntries(Object.entries(process.env).filter(([name]) => !HOOK_GIT_VARIABLES.has(name)));
    const revision = spawnSync("git", ["-C", root, "rev-parse", "HEAD"], { env, encoding: "utf8" });
    if (revision.status !== 0 || revision.stdout.trim() !== pins.catalogCommit) throw new Error("Catalog commit differs from proof pin");
    if (digest(join(root, "patches/telegram@2.26.22.patch")) !== pins.sdkPatchSha256) throw new Error("SDK patch differs from proof pin");
    const source = join(root, "plugins/sources/telegram/src");
    const resolveFrom = createRequire(join(source, "package.json")).resolve;
    const installedSdk = dirname(resolveFrom("telegram"));
    for (const [member, expected] of Object.entries(pins.sdkMembers)) {
      if (digest(join(installedSdk, member)) !== expected) throw new Error(`Installed SDK member differs from proof pin: ${member}`);
    }
    const dirty = spawnSync("git", ["-C", root, "diff", pins.catalogCommit, "--", "plugins/sources/telegram/src", "patches/telegram@2.26.22.patch"], { env, encoding: "utf8" });
    if (dirty.status !== 0 || dirty.stdout.length !== 0) throw new Error("Pinned Source production/fixture files have uncommitted changes");
    const fixture = await import(join(source, "testing/mtproto-transport.ts")) as TransportModule;
    const live = await import(join(source, "live.ts")) as LiveModule;
    const dispatch = await import(join(source, "dispatch.ts")) as DispatchModule;
    const subscriptions = await import(join(source, "subscriptions.ts")) as { SubscriptionRegistry: new () => Registry };
    const sdk = object(await import(resolveFrom("telegram")));
    const integers = object(await import(resolveFrom("big-integer")));
    const integer = integers["default"];
    if (typeof integer !== "function") throw new Error("Missing real SDK integer constructor");
    const time = new fixture.VirtualClock();
    time.advance(Date.parse("2026-09-15T00:00:00Z"));
    const options: { clock: VirtualClock; diagnostics(): void; transport?: Record<string, unknown> } = { clock: time, diagnostics: () => undefined };
    const pool = new live.SessionPool(options);
    const choosePool = spyOn(live, "pool").mockReturnValue(pool);
    let session = "";
    try {
      const transport = await fixture.createTransport(time, pool.admissionFor("telegram-fast-proof-account"), true, (settings, saved) => {
        options.transport = settings;
        session = saved;
        return pool.getOrCreate("telegram-fast-proof-account", { api_id: 1, api_hash: "synthetic", session });
      });
      const provider = new TelegramSourceProvider(root, object(sdk["Api"]), (value) => Reflect.apply(integer, undefined, [value]) as unknown,
        dispatch, subscriptions.SubscriptionRegistry, time, pool, () => { choosePool.mockRestore(); }, transport, session, () => fixture.setupConfig());
      const timers: { setTimeout: (callback: (...args: unknown[]) => void, delay?: number, ...args: unknown[]) => ReturnType<typeof setTimeout> } = globalThis;
      const timerMock = timers.setTimeout as typeof timers.setTimeout & { getMockImplementation(): typeof timers.setTimeout | undefined };
      const realTimeout = timerMock.getMockImplementation();
      if (!realTimeout) throw new Error("Expected the catalog fixture's low-level timer implementation");
      const timeoutSpy = spyOn(timers, "setTimeout").mockImplementation((callback, delay, ...args) => {
        if (delay !== undefined && delay > 10_000 && delay <= 25_000) provider.timeout = () => { callback(...args); };
        return realTimeout(callback, delay, ...args);
      });
      provider.restoreTimeout = () => { timeoutSpy.mockRestore(); };
      await Promise.race([transport.connected, provider.loop.then(() => {
        throw new Error(`Provider setup stopped: ${provider.errors.join("; ")}`);
      })]);
      return provider;
    } catch (error) { choosePool.mockRestore(); throw error; }
  }

  private tl(name: string, args: Record<string, unknown> = {}): TlObject {
    let entry: unknown = this.api;
    for (const part of name.split(".")) entry = object(entry)[part];
    if (typeof entry !== "function") throw new Error(`Missing SDK TL constructor ${name}`);
    return Reflect.construct(entry, [args]) as TlObject;
  }
  private chat(id: number): TlObject {
    return this.tl("Chat", { id: this.integer(id), title: `Chat ${String(id)}`, photo: this.tl("ChatPhotoEmpty"), participantsCount: 2, date: 1, version: 1 });
  }
  private message(chat: number, id: number): TlObject {
    return this.tl("Message", { id, peerId: this.tl("PeerChat", { chatId: this.integer(chat) }),
      fromId: this.tl("PeerUser", { userId: this.integer(9001) }), date: 1_700_000_000 + id, message: `message ${String(chat)}/${String(id)}` });
  }
  private vector(items: TlObject[]): TlObject {
    return { getBytes: () => { const header = Buffer.alloc(8); header.writeUInt32LE(0x1cb5c415); header.writeInt32LE(items.length, 4); return Buffer.concat([header, ...items.map((item) => item.getBytes())]); } };
  }
  holdNextHistory(after = 0): void { this.holdAfter = after; this.pause.set("history", deferred<undefined>()); this.entered.set("history", deferred<undefined>()); }
  async historyHeld(): Promise<void> { await this.entered.get("history")?.promise; }
  releaseHistory(): void { this.pause.get("history")?.resolve(undefined); this.pause.delete("history"); }
  floodNextHistory(seconds = 4): void { this.flood = seconds; }
  expireHistoryTimeout(): void {
    if (!this.timeout) throw new Error("No real Source history timeout was armed");
    this.timeout();
  }
  async probeHeldAdmission(): Promise<unknown> {
    return this.transport.client.invoke(this.tl("updates.GetState")).then(
      () => { throw new Error("Held SDK request unexpectedly succeeded"); },
      (error: unknown) => error,
    );
  }
  advance(ms: number): void { this.time.advance(ms); }
  admission(): { holdUntil: number | null; remoteFloods: number; localRefusals: number } { return this.pool.admissionFor(this.account); }
  expected(): string[] {
    return [...this.histories].flatMap(([chat, count]) => Array.from({ length: count }, (_, index) => `tg:msg:${String(chat)}:${String(index + 1)}`)).sort();
  }
  async publishLive(chat: number): Promise<void> {
    const id = (this.histories.get(chat) ?? 0) + 1;
    this.histories.set(chat, id);
    await this.transport.incoming(this.tl("Updates", {
      updates: [this.tl("UpdateNewMessage", { message: this.message(chat, id), pts: id, ptsCount: 1 })],
      chats: [this.chat(chat)], users: [this.tl("User", { id: this.integer(9001), self: true, firstName: "Synthetic" })], date: 1_700_000_000 + id, seq: id,
    }));
  }
  binding(): Promise<SourceBindingResource> {
    const input = new PassThrough(); const output = new PassThrough();
    const pending = new Map<number, (typeof this.calls)[number]>();
    input.on("data", (chunk: Buffer) => {
      for (const line of chunk.toString().trim().split("\n")) {
        const frame = object(JSON.parse(line));
        if (frame["method"] !== "tools/call" || typeof frame["id"] !== "number") continue;
        const params = object(frame["params"]); const args = { ...object(params["arguments"]) }; delete args["_meta"];
        const call = { name: String(params["name"]), args, started: performance.now(), elapsed: null };
        pending.set(frame["id"], call); this.calls.push(call);
      }
    });
    const registry = new this.RegistryType();
    const client = McpClient.connect(output, input, { now: this.clock.now, deadlines: { schedule: (delay, run) => this.time.schedule(run, delay) } });
    const task = this.dispatch.runMcpStdio(input, { authMode: false, registry, write: (line) => {
      const parsed = object(JSON.parse(line)); this.wire.push(parsed);
      const call = typeof parsed["id"] === "number" ? pending.get(parsed["id"]) : undefined;
      if (call) { call.elapsed = performance.now() - call.started; call.response = parsed; }
      output.write(`${line}\n`);
    } });
    let closed = false;
    const close = async (): Promise<void> => {
      if (closed) return; closed = true;
      input.end(); await task; client.close(); output.end(); this.resources.delete(close);
    };
    this.resources.add(close);
    return Promise.resolve({ client, probe: async () => { await client.initialize({ signal: client.lifetimeSignal() }); },
      close, joined: task.then(() => ({ reason: "fixture_stdio_closed" })) });
  }
  private async answerLoop(): Promise<void> {
    for (let index = 0; !this.stopped; index++) {
      const sent = await Promise.race([this.transport.application(index), this.ended.promise.then(() => null)]);
      if (sent === null) return;
      const request = sent.state.request;
      const method = sent.method;
      const peer = request["peer"];
      const chatId = peer === undefined ? null : Number(String(object(peer)["chatId"]));
      const offset = typeof request["offsetId"] === "number" ? request["offsetId"] : 0;
      const limit = typeof request["limit"] === "number" ? request["limit"] : 0;
      const observed: (typeof this.requests)[number] = { method, chat: chatId, offset, limit, at: sent.at };
      this.requests.push(observed);
      let response: TlObject;
      if (method === "InvokeWithLayer") response = this.setupConfig();
      else if (method === "updates.GetState") response = this.tl("updates.State", { pts: 0, qts: 0, date: 1, seq: 0, unreadCount: 0 });
      else if (method === "users.GetUsers") response = this.vector([this.tl("User", { id: this.integer(9001), self: true, firstName: "Synthetic" })]);
      else if (method === "messages.GetDialogs") {
        const entries = offset === 0 ? [...this.histories] : [];
        response = this.tl("messages.Dialogs", { dialogs: entries.map(([id, count], index) => this.tl("Dialog", {
          pinned: index < 2, peer: this.tl("PeerChat", { chatId: this.integer(id) }), topMessage: count,
          readInboxMaxId: 0, readOutboxMaxId: 0, unreadCount: 0, unreadMentionsCount: 0, unreadReactionsCount: 0,
          notifySettings: this.tl("PeerNotifySettings"),
        })), chats: entries.map(([id]) => this.chat(id)), users: [], messages: entries.filter(([, count]) => count > 0).map(([id, count]) => this.message(id, count)) });
      } else if (method === "messages.GetHistory" && chatId !== null && this.histories.has(chatId)) {
        const hold = this.pause.get("history");
        if (hold && this.requests.filter((item) => item.method === "messages.GetHistory").length > this.holdAfter) { this.entered.get("history")?.resolve(undefined); await hold.promise; }
        const flood = this.flood; this.flood = null;
        if (flood !== null) response = this.tl("RpcError", { errorCode: 420, errorMessage: "FLOOD_WAIT_" + String(flood) });
        else {
          const total = this.histories.get(chatId) ?? 0;
          const before = offset === 0 ? total + 1 : offset;
          const ids = Array.from({ length: total }, (_, i) => total - i).filter((id) => id < before).slice(0, limit);
          observed.returned = ids.length; observed.total = total;
          response = this.tl("messages.MessagesSlice", { count: total, messages: ids.map((id) => this.message(chatId, id)), chats: [this.chat(chatId)], users: [] });
        }
      } else throw new Error(`Unexpected real Telegram request: ${method}`);
      await this.transport.reply(sent, response);
    }
  }
  async close(): Promise<void> {
    this.releaseHistory(); this.stopped = true; this.ended.resolve(undefined);
    for (const close of this.resources) await close();
    await this.loop;
    this.restoreTimeout();
    try { await this.pool.evict(this.account); await this.transport.close(); }
    finally { this.restorePool(); }
  }
}

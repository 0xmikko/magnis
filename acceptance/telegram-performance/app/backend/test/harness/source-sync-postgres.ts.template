import { randomUUID } from "node:crypto";

import pg from "pg";

/** A lease, not a database launcher: the caller provisions native PostgreSQL.
 * Every scenario owns one database; the server outlives backend restarts. */
export interface SourceSyncDatabase {
  readonly connectionString: string;
  readonly reader: pg.Client;
  close(): Promise<void>;
}

export async function createSourceSyncDatabase(): Promise<SourceSyncDatabase> {
  const configured = process.env["MAGNIS_SYNC_TEST_DATABASE_URL"];
  if (!configured) {
    throw new Error("Source sync prerequisite: set MAGNIS_SYNC_TEST_DATABASE_URL to an explicitly provisioned native PostgreSQL test server");
  }
  const url = new URL(configured);
  const admin = new pg.Client({ connectionString: url.href, connectionTimeoutMillis: 5_000 });
  const name = `magnis_sync_${randomUUID().replaceAll("-", "")}`;
  const quotedName = `"${name}"`;
  let created = false;
  let reader: pg.Client | undefined;
  try {
    await admin.connect();
    await admin.query(`CREATE DATABASE ${quotedName}`);
    created = true;
    url.pathname = `/${name}`;
    reader = new pg.Client({ connectionString: url.href, connectionTimeoutMillis: 5_000 });
    await reader.connect();
  } catch (error) {
    await reader?.end();
    if (created) await admin.query(`DROP DATABASE ${quotedName}`);
    await admin.end();
    throw error;
  }
  const connection = reader;
  let closed = false;
  return {
    connectionString: url.href,
    reader: connection,
    async close(): Promise<void> {
      if (closed) return;
      closed = true;
      try {
        await connection.end();
        // No FORCE: a leaked backend connection must fail cleanup visibly.
        await admin.query(`DROP DATABASE ${quotedName}`);
      } finally {
        await admin.end();
      }
    },
  };
}

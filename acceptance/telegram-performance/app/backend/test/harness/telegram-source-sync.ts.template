import { createHash } from "node:crypto";
import { mkdirSync, mkdtempSync, readFileSync, readdirSync, rmdirSync } from "node:fs";
import { join, resolve } from "node:path";
import { performance } from "node:perf_hooks";

import { spyOn } from "bun:test";

import { ConfigService } from "../../src/config/config.service.js";
import { DEFAULT_USER_ID } from "../../src/core/auth.js";
import type { SourceWorkerState } from "../../src/core/sync-state.js";
import { UnitOfWork, type UnitOfWorkScope } from "../../src/db/unit-of-work.js";
import { PluginHostClient } from "../../src/plugin-runtime/plugin-host.client.js";
import * as pluginOperations from "../../src/plugin-runtime/ops/build-ops.js";
import { EventBus } from "../../src/process/event-bus.js";
import { ExtensionService } from "../../src/services/extensions/extension.service.js";
import { removeWritableTree } from "../../src/services/extensions/remote-package-files.js";
import { SecretRepository } from "../../src/services/secrets/secret.repository.js";
import { SourceRepository } from "../../src/services/sources/accounts/source.repository.js";
import { SourceDefinitionRegistry } from "../../src/services/sources/bootstrap/source-definition.registry.js";
import type { AccountSyncState } from "@magnis/sdk";
import { buildSourceStatusProjection } from "../../src/services/sources/source-status.projection.js";
import { SourceCredentialLocatorResolver } from "../../src/services/sources/accounts/source-credential-locator.resolver.js";
import { SourceBindingRegistry } from "../../src/services/sources/runtime/source-runtime.supervisor.js";
import { McpSourceRuntime } from "../../src/services/sources/runtime/source-runtime.js";
import type { BindingPool, CertifiedSurfaceProgress } from "../../src/services/sources/runtime/source-host.server.js";
import { SourceReconciler } from "../../src/services/sources/runtime/source-reconciler.js";
import { SyncService } from "../../src/services/sources/sync/sync.service.js";
import { SyncRouter } from "../../src/services/sources/sync/sync.router.js";
import { SyncStateRepository } from "../../src/services/sources/sync/sync.repository.js";
import { SourcesModule } from "../../src/services/sources/sources.module.js";
import { AccountSubjectSource, newWorkerState } from "../../src/services/sources/types.js";
import { TokioClock } from "../../src/utils/clock.js";
import { type JsonValue } from "../../src/utils/json.js";
import { writeFixtureArchiveChannel } from "./fixture-packages.js";
import { bootProduction } from "./logging.js";
import { createSourceSyncDatabase } from "./source-sync-postgres.js";
import { TelegramSourceProvider } from "./telegram-source-provider.js";
import pins from "../fixtures/telegram-fast-sync/pins.json" with { type: "json" };

const root = resolve(import.meta.dirname, "../../..");
const progress: CertifiedSurfaceProgress = {
  target: "per_identity_history", coverage: "per_identity_range", continuation: "opaque_cursor",
  forwardCheckpoint: "opaque_cursor", liveFence: "subscription_ack",
};
interface ExecutionSpan {
  kind: "dispatch" | "transaction" | "operation";
  name: string;
  requestId: string | null;
  transaction: number | null;
  began: number;
  ended: number | null;
  error: string | null;
  callbackBegan?: number;
  callbackEnded?: number;
  envelopes?: number;
  chats?: number;
  messages?: number;
}
export interface TelegramSyncStand {
  readonly provider: TelegramSourceProvider;
  start(): Promise<void>;
  state(): Promise<SourceWorkerState>;
  ownership(): { workers: number; sourcePresent: boolean; receiverPresent: boolean; lifecycle: readonly string[] };
  messages(): Promise<string[]>;
  waitFor(label: string, predicate: (state: SourceWorkerState) => boolean | Promise<boolean>): Promise<SourceWorkerState>;
  graphBlocked(): Promise<boolean>;
  /** The surface's sync as the wire carries it: what the worker holds, null without a worker. */
  sync(): Promise<AccountSyncState | null>;
  blockGraph(): Promise<() => Promise<void>>;
  failGraph(): Promise<() => Promise<void>>;
  restart(): Promise<void>;
  evidence(): Promise<Record<string, unknown>>;
  diagnostics(): Promise<Record<string, unknown>>;
  close(): Promise<void>;
}

/** Actual Nest services and module processes; only credentials, time and the
 * Source OS spawn are test-owned. No provider-shaped Source results are used. */
export async function bootTelegramSync(): Promise<TelegramSyncStand> {
  const tempRoot = join(root, ".tmp/code-production/telegram-fast-sync-proof/D1-S1");
  mkdirSync(tempRoot, { recursive: true });
  const directory = mkdtempSync(join(tempRoot, "stand."));
  const database = await createSourceSyncDatabase();
  let app: Awaited<ReturnType<typeof bootProduction>> | undefined;
  let provider: TelegramSourceProvider | undefined;
  let runtime: McpSourceRuntime | undefined;
  let bindings: SourceBindingRegistry | undefined;
  let restoreClock = (): void => undefined;
  let releaseGraph: (() => Promise<void>) | undefined;
  let stopObserving = (): void => undefined;
  let restoreExecutionObservations = (): void => undefined;
  const started = performance.now();
  let syncStarted = started;
  let closePromise: Promise<void> | undefined;
  const cleanup = async (): Promise<void> => {
    provider?.releaseHistory();
    try {
      await releaseGraph?.();
      await app?.container.get(SyncService).reconcileWorkers([]);
      await runtime?.shutdown();
      await bindings?.stopAll("proof_complete");
      await provider?.close();
      stopObserving();
      restoreExecutionObservations();
      restoreClock();
      await app?.shutdown();
    } finally { try { await database.close(); } finally {
      removeWritableTree(directory);
      if (readdirSync(tempRoot).length === 0) rmdirSync(tempRoot);
    } }
  };
  const close = (): Promise<void> => {
    closePromise ??= cleanup();
    return closePromise;
  };
  try {
    const sourceRoot = join(directory, "sources"); mkdirSync(sourceRoot);
    const channelRoot = join(directory, "channel"); mkdirSync(channelRoot);
    const config = ConfigService.fromEnvironment("serve", {
      DATABASE_URL: database.connectionString, STORAGE_DIR: join(directory, "storage"),
      EXTENSIONS_DIR: sourceRoot, MAGNIS_CATALOG_URL: `file://${channelRoot}`,
      SOURCE_SECRETS_MASTER_KEY: "11".repeat(32), AUTH_JWT_SECRET: "telegram-proof-only-jwt",
      ENABLED_SOURCES: "", MAGNIS_DISABLE_INDEXER: "1", EMBEDDINGS_PROVIDER: "deterministic",
      LOG_LEVEL: "error", PORT: "0", SKILLS_CATALOG_DIR: join(directory, "skills-catalog"), SKILLS_ACTIVE_DIR: join(directory, "skills"),
    });
    app = await bootProduction("express", config);
    const container = app.container;
    const extensions = container.get(ExtensionService);
    for (const id of ["file", "triggers", "email", "companies", "contacts", "telegram"]) {
      const archive = readFileSync(join(root, id === "telegram" ? "test-e2e/fixtures/telegram-unicode/module__telegram.tgz" : `test-e2e/fixtures/channel/module__${id}.tgz`));
      if (id === "telegram" && createHash("sha256").update(archive).digest("hex") !== pins.telegramModuleSha256) throw new Error("Telegram module changed");
      writeFixtureArchiveChannel(channelRoot, "module", id, "0.1.0", archive, 2);
      const channel = await extensions.refreshChannel(DEFAULT_USER_ID);
      if (!channel.available) throw new Error(`Module fixture channel unavailable: ${JSON.stringify(channel)}`);
      await extensions.install(DEFAULT_USER_ID, `module:${id}`);
      const enabled = await extensions.enable(DEFAULT_USER_ID, `module:${id}`);
      if (enabled.state !== "active") throw new Error(`Module ${id} did not activate: ${JSON.stringify(enabled)}`);
    }
    // Artifact activation publishes receiver changes asynchronously. Finish its
    // real Source refresh before registering this test-owned Source definition.
    await container.get(SyncRouter).receiversSettled();
    provider = await TelegramSourceProvider.open();
    const remote = provider;
    const spans: ExecutionSpan[] = [];
    const scopes = new WeakMap<UnitOfWorkScope, number>();
    let nextTransaction = 0;
    let requestId: string | null = null;
    const span = (kind: ExecutionSpan["kind"], name: string, transaction: number | null = null): ExecutionSpan => ({
      kind, name, requestId, transaction, began: performance.now(), ended: null, error: null,
    });
    const observe = async <T>(entry: ExecutionSpan, operation: () => Promise<T>): Promise<T> => {
      spans.push(entry);
      try { return await operation(); }
      catch (error) { entry.error = error instanceof Error ? error.message : String(error); throw error; }
      finally { entry.ended = performance.now(); }
    };
    const dispatchObservation = spyOn(PluginHostClient.prototype, "dispatch");
    const dispatchOriginal = dispatchObservation.getMockImplementation();
    if (dispatchOriginal === undefined) { dispatchObservation.mockRestore(); throw new Error("Real plugin dispatch implementation missing"); }
    dispatchObservation.mockImplementation(function (this: PluginHostClient, ...args) {
      const [id, method, params] = args;
      if (method !== "telegram.__sync__") return dispatchOriginal.apply(this, args);
      requestId = id;
      const entry = span("dispatch", method);
      if (params !== null && typeof params === "object" && !Array.isArray(params) && Array.isArray(params.envelopes)) {
        entry.envelopes = params.envelopes.length; entry.chats = 0; entry.messages = 0;
        for (const envelope of params.envelopes) {
          if (envelope === null || typeof envelope !== "object" || Array.isArray(envelope)) continue;
          const payload = envelope.payload;
          if (payload === null || typeof payload !== "object" || Array.isArray(payload)) continue;
          if (payload.entity_type === "telegram_chat") entry.chats += 1;
          if (typeof payload.message_id === "number") entry.messages += 1;
        }
      }
      return observe(entry, () => dispatchOriginal.apply(this, args)).finally(() => { if (requestId === id) requestId = null; });
    });
    const transactionObservation = spyOn(UnitOfWork.prototype, "run");
    const runOriginal = transactionObservation.getMockImplementation();
    if (runOriginal === undefined) { transactionObservation.mockRestore(); dispatchObservation.mockRestore(); throw new Error("Real transaction implementation missing"); }
    transactionObservation.mockImplementation(async function <T>(this: UnitOfWork, work: (scope: UnitOfWorkScope) => Promise<T>): Promise<T> {
      const transaction = ++nextTransaction;
      const entry = span("transaction", "UnitOfWork.run", transaction);
      const run = runOriginal.bind(this);
      return observe(entry, () => run(async (scope) => {
        scopes.set(scope, transaction);
        entry.callbackBegan = performance.now();
        try { return await work(scope); }
        finally { entry.callbackEnded = performance.now(); }
      }));
    });
    const operationOriginal = pluginOperations.dispatchPluginOp;
    const operationObservation = spyOn(pluginOperations, "dispatchPluginOp").mockImplementation((state, name, args) => {
      if (state.syncProvenance?.account_id !== remote.account) return operationOriginal(state, name, args);
      const transaction = state.syncScope === null ? null : scopes.get(state.syncScope) ?? null;
      return observe(span("operation", name, transaction), () => operationOriginal(state, name, args));
    });
    restoreExecutionObservations = (): void => {
      operationObservation.mockRestore(); transactionObservation.mockRestore(); dispatchObservation.mockRestore();
    };
    const diagnostics = async (): Promise<Record<string, unknown>> => {
      const sampledAt = performance.now();
      const databaseActivity = await database.reader.query<{ pid: number; state: string; wait_event_type: string | null; wait_event: string | null; blockers: number[]; transaction_ms: number | null; query_ms: number | null }>(
        `SELECT pid,state,wait_event_type,wait_event,pg_blocking_pids(pid) AS blockers,
          extract(epoch FROM (clock_timestamp()-xact_start))*1000 AS transaction_ms,
          extract(epoch FROM (clock_timestamp()-query_start))*1000 AS query_ms
          FROM pg_stat_activity WHERE datname=current_database() AND pid<>pg_backend_pid()`);
      return { sampledAt, database: databaseActivity.rows,
        counts: { dispatch: spans.filter((entry) => entry.kind === "dispatch").length,
          transaction: spans.filter((entry) => entry.kind === "transaction").length,
          operation: spans.filter((entry) => entry.kind === "operation").length },
        dispatches: spans.filter((entry) => entry.kind === "dispatch").map((entry) => {
          const operations = spans.filter((operation) => operation.kind === "operation" && operation.requestId === entry.requestId);
          const operationCounts: Record<string, number> = {};
          for (const operation of operations) operationCounts[operation.name] = (operationCounts[operation.name] ?? 0) + 1;
          return { ...entry, operationCounts, operationMillis: operations.reduce((sum, operation) => sum + ((operation.ended ?? sampledAt)-operation.began), 0) };
        }),
        transactions: spans.filter((entry) => entry.kind === "transaction"),
        slowOperations: spans.filter((entry) => entry.kind === "operation").sort((left, right) =>
          ((right.ended ?? sampledAt)-right.began)-((left.ended ?? sampledAt)-left.began)).slice(0, 12),
        recentOperations: spans.filter((entry) => entry.kind === "operation").slice(-12),
        sourceCalls: remote.calls.map(({ name, elapsed }) => ({ name, elapsed })) };
    };
    // These observations commit or roll back WITH the real Graph transaction.
    await database.reader.query(`CREATE TABLE proof_graph_timing (tx bigint PRIMARY KEY, began timestamptz NOT NULL, last_write timestamptz NOT NULL, writes integer NOT NULL);
      CREATE FUNCTION proof_graph_observe() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
        INSERT INTO proof_graph_timing VALUES (txid_current(),transaction_timestamp(),clock_timestamp(),1)
        ON CONFLICT (tx) DO UPDATE SET last_write=clock_timestamp(),writes=proof_graph_timing.writes+1;
        RETURN NEW; END $$;
      CREATE TRIGGER proof_graph_observe AFTER INSERT OR UPDATE ON entities FOR EACH ROW
        WHEN (NEW.schema_id IN ('telegram.message','telegram.chat')) EXECUTE FUNCTION proof_graph_observe()`);
    const clock = container.select(SourcesModule).get(TokioClock, { strict: true });
    const now = spyOn(clock, "now").mockImplementation(remote.clock.now);
    const sleep = spyOn(clock, "sleep").mockImplementation(remote.clock.sleep);
    restoreClock = (): void => { now.mockRestore(); sleep.mockRestore(); };
    const hash = `sha256:${createHash("sha256").update(pins.catalogCommit).digest("hex")}`;
    const secrets = container.get(SecretRepository);
    const subject = `${DEFAULT_USER_ID}:${remote.account}:1`;
    await secrets.put("sources.telegram.session", subject, "value", Buffer.from(remote.session));
    const ownedBindings = new SourceBindingRegistry(() => remote.binding());
    bindings = ownedBindings;
    const pool: BindingPool = {
      acquire: async (request) => {
        if (request.authority !== "moduleSync" || request.userId !== DEFAULT_USER_ID || request.accountId !== remote.account || request.accountGeneration !== 1) throw new Error("Foreign proof binding");
        return ownedBindings.start({ key: { authority: "moduleSync", sourceId: "telegram", userId: DEFAULT_USER_ID, accountId: remote.account, artifactHash: hash, accountGeneration: 1 },
          protocol: "magnis.source/1", process: { host: config.plugins.sourceHost, entry: join(remote.root, "plugins/sources/telegram/src/main.ts"), environment: new Map() } });
      },
      credential: async (userId, accountId, generation): Promise<JsonValue> => {
        if (userId !== DEFAULT_USER_ID || accountId !== remote.account || generation !== 1) throw new Error("Foreign proof credential");
        const session = await secrets.get("sources.telegram.session", subject, "value");
        if (session === null) throw new Error("Synthetic credential vanished");
        return { account_id: accountId, user_id: userId, api_id: 1, api_hash: "synthetic", session: Buffer.from(session).toString() };
      },
      close: async () => { await ownedBindings.stopAll("proof_reopen"); },
    };
    runtime = new McpSourceRuntime("telegram", { surface: "telegram", sync_mode: "push", schema: null }, pool, progress, { kind: "retain" }).withEventBus(container.get(EventBus));
    const router = container.get(SyncRouter);
    router.addRuntime("telegram", "telegram", runtime, { protocol: "magnis.source/1", sourceId: "telegram", surface: "telegram", artifactHash: hash }, "push");
    const accounts = container.get(SourceRepository);
    router.setIdentityKeySource(new AccountSubjectSource(accounts));
    const states = container.get(SyncStateRepository);
    const initial = newWorkerState(DEFAULT_USER_ID, "telegram", "telegram", remote.account, 1);
    await database.reader.query(`INSERT INTO source_connections
      (connection_id,user_id,source_id,provider_account_id,display_name,status,auth_type,artifact_hash,created_at,updated_at)
      VALUES ($1,$2,'telegram','9001','Synthetic Telegram','connected','phone_code',$3,'2026-09-15T00:00:00Z','2026-09-15T00:00:00Z')`, [remote.account, DEFAULT_USER_ID, hash]);
    await database.reader.query(`INSERT INTO source_accounts
      (id,user_id,source_id,surface,account_id,subject,enabled,created_at,updated_at)
      VALUES ('telegram-proof-membership',$1,'telegram','telegram',$2,'9001',TRUE,'2026-09-15T00:00:00Z','2026-09-15T00:00:00Z')`, [DEFAULT_USER_ID, remote.account]);
    await states.upsert(initial);
    const definitions = container.get(SourceDefinitionRegistry);
    const lifecycle: string[] = [];
    definitions.onPublished((snapshot) => { lifecycle.push("definitions:" + snapshot.map(({ sourceId }) => sourceId).join(",")); });
    stopObserving = router.onReceiversChanged(() => {
      lifecycle.push("receiver:" + String(router.moduleFor("telegram") !== null));
      return Promise.resolve();
    });
    definitions.replace([{ sourceId: "telegram", displayName: "Telegram", version: "1.0.1", packageHash: hash, definitionHash: hash,
      releaseTier: "production", authKind: "phoneCode", surfaces: [{ surface: "telegram", receiverId: "telegram", syncMode: "push" }] }], []);
    const reconciler = container.get(SourceReconciler);
    const ownership = (): { workers: number; sourcePresent: boolean; receiverPresent: boolean; lifecycle: readonly string[] } => ({
      workers: container.get(SyncService).workerCount(), sourcePresent: definitions.get("telegram")?.packageHash === hash,
      receiverPresent: router.moduleFor("telegram") !== null, lifecycle: [...lifecycle],
    });
    const state = async (): Promise<SourceWorkerState> => {
      const row = await states.get(DEFAULT_USER_ID, "telegram", "telegram", remote.account);
      if (!row) throw new Error("Proof sync row vanished");
      return row;
    };
    const messages = async (): Promise<string[]> => {
      const result = await database.reader.query<{ anchor: string }>("SELECT source->>'externalId' AS anchor FROM entities WHERE owner=$1 AND schema_id='telegram.message' AND is_archived IS NOT TRUE ORDER BY 1", [DEFAULT_USER_ID]);
      return result.rows.map(({ anchor }) => anchor);
    };
    const projection = async (): Promise<AccountSyncState | null> => {
      const statuses = await buildSourceStatusProjection({
        userId: DEFAULT_USER_ID,
        installed: [{ sourceId: "telegram", packageHash: hash, enabled: true }],
        definitions: container.get(SourceDefinitionRegistry).list(), unavailableDefinitions: [],
        generations: await accounts.listGenerationsForUser(DEFAULT_USER_ID),
        memberships: await accounts.listEnrollmentsForUser(DEFAULT_USER_ID),
        resolveCredential: (locator) => container.get(SourceCredentialLocatorResolver).resolve(locator),
        bindingStatus: (key) => ownedBindings.status(key),
        accountSyncState: (binding) => container.get(SyncService).accountSyncState(binding),
      });
      const surface = statuses[0]?.accounts[0]?.surfaces.find((entry) => entry.surface === "telegram");
      if (surface === undefined) throw new Error("Real Telegram status projection missing");
      return surface.sync;
    };
    return {
      provider: remote, state, ownership, messages, sync: projection, diagnostics,
      start: () => { syncStarted = performance.now(); return reconciler.reconcile(); }, close,
      async waitFor(label, predicate): Promise<SourceWorkerState> {
        const deadline = performance.now() + 20_000;
        while (performance.now() < deadline) {
          if (remote.errors.length > 0) throw new Error(`${label}: ${remote.errors.join("; ")}`);
          const row = await state();
          const owner = ownership();
          if (!owner.sourcePresent || !owner.receiverPresent || owner.workers !== 1) {
            throw new Error(`${label}: ownership changed: ${JSON.stringify(owner)}`);
          }
          if (await predicate(row)) return row;
          await new Promise<void>((resolveTurn) => { setImmediate(resolveTurn); });
        }
        const row = await state();
        throw new Error(`${label}: ${JSON.stringify({ stage: row.state.stage, hold: row.state.hold, ownership: ownership(), execution: await diagnostics(), requests: remote.requests.slice(-4) })}`);
      },
      async blockGraph(): Promise<() => Promise<void>> {
        await database.reader.query("BEGIN; LOCK TABLE entities IN SHARE MODE");
        const release = async (): Promise<void> => { await database.reader.query("COMMIT"); releaseGraph = undefined; };
        releaseGraph = release; return release;
      },
      async graphBlocked(): Promise<boolean> {
        const result = await database.reader.query<{ count: string }>("SELECT count(*) FROM pg_stat_activity WHERE datname=current_database() AND pid<>pg_backend_pid() AND wait_event_type='Lock'");
        return Number(result.rows[0]?.count) > 0;
      },
      async failGraph(): Promise<() => Promise<void>> {
        await database.reader.query(`CREATE FUNCTION proof_reject_message() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic Graph storage failure'; END $$;
          CREATE TRIGGER proof_reject BEFORE INSERT ON entities FOR EACH ROW WHEN (NEW.schema_id='telegram.message') EXECUTE FUNCTION proof_reject_message()`);
        return async () => { await database.reader.query("DROP TRIGGER proof_reject ON entities; DROP FUNCTION proof_reject_message()"); };
      },
      async restart(): Promise<void> {
        await container.get(SyncService).reconcileWorkers([]);
        await reconciler.reconcile();
      },
      async evidence(): Promise<Record<string, unknown>> {
        const sync = await projection();
        const synced = sync?.progress["telegram.message"]?.synced ?? 0;
        const transactions = await database.reader.query<{ transactions: string; writes: string; milliseconds: number }>("SELECT count(*) AS transactions, coalesce(sum(writes),0) AS writes, coalesce(sum(extract(epoch FROM (last_write-began))*1000),0)::float8 AS milliseconds FROM proof_graph_timing");
        const chats = await database.reader.query<{ chats: string; pinned: string }>("SELECT count(*) AS chats,count(*) FILTER (WHERE EXISTS (SELECT 1 FROM links WHERE links.to_entity=entities.id AND kind='observed_in' AND metadata->>'is_pinned'='true')) AS pinned FROM entities WHERE schema_id='telegram.chat'");
        const elapsedMillis = performance.now() - syncStarted;
        return { catalog: pins.catalogCommit, sdkPatch: pins.sdkPatchSha256, wireRequests: remote.requests.length, remoteWaits: remote.admission().remoteFloods,
          synced, estimation: sync?.progress["telegram.message"]?.estimation ?? null, stage: sync?.status ?? null,
          elapsedMillis, bootIncludedMillis: performance.now() - started,
          sourceCalls: remote.calls.map(({ name, elapsed }) => ({ name, elapsed })), graph: transactions.rows[0],
          chats: Number(chats.rows[0]?.chats), pinned: Number(chats.rows[0]?.pinned),
          historyPages: remote.requests.filter((request) => request.offset > 0),
          durableMessagesPerSecond: synced / (elapsedMillis / 1000), providerElapsedMillis: remote.clock.now() - Date.parse("2026-09-15T00:00:00Z") };
      },
    };
  } catch (error) { await close(); throw error; }
}

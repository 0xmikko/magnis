    expect(download).toHaveBeenCalledTimes(1);
  } finally { mark.mockRestore(); download.mockRestore(); }
}, 60_000);

/**
 * @test-id: tst_src_int_telegram_graph_005
 * @scenario: scn_sync_live_coverage_003
 * @covers: SyncWorker.admitLive; SyncRouter.routeSyncPage; SyncStateRepository.updateOwned
 * @deterministic: yes; fixture Source events and acknowledgements, no provider calls
 * Test environment: real Telegram child module, Graph and native PostgreSQL owned repository.
 * Clients: schedule-selected worker turns. Mocks: external certified v1 Source listen/events only.
 * Data: points 102/104, edit/replay104 and an opaque forward checkpoint.
 * This verifies S17's existing fix on native storage; it is not Telegram connectivity
 * or full catch-up/gap scheduling proof. Pending catch-up is not reported complete.
 */
test.skipIf(process.env["MAGNIS_SYNC_TEST_DATABASE_URL"] === undefined)("tst_src_int_telegram_graph_005 native live points survive replay and recreation without filling holes", async () => {
  const h = await stand();
  await h.ingest([h.chat()]);
  const commands: SourceCommand["kind"][] = [];
  const accounts = new SourceRepository(h.db);
  await accounts.setSubject(h.state.key.userId, "telegram", h.state.key.accountId, "9001");
  h.router.setIdentityKeySource(new AccountSubjectSource(accounts));
  h.router.addModule("telegram", h.controller);
  addLegacyRuntime(h.router, "telegram", "telegram", {
    descriptor: () => Promise.resolve({ ...testDescriptor("telegram", "telegram"), syncMode: "push" }),
    certifiedProgress: () => ({
      target: "per_identity_history", coverage: "per_identity_range",
      continuation: "opaque_cursor", forwardCheckpoint: "opaque_cursor", liveFence: "subscription_ack",
    }),
    executeCommand: (command) => {
      commands.push(command.kind);
      if (command.kind === "listen_start") return Promise.resolve({ status: "listening", boundary: "fixture-fence" });
      if (command.kind === "listen_stop") return Promise.resolve({ status: "stopped" });
      return Promise.reject(new Error(`unexpected provider work: ${command.kind}`));
    },
  }, "push");
  const checkpoint = { pts: "opaque-fixture-checkpoint" };
  // History is done and the open range of chat 42 starts above what was seen.
  const row = { ...h.state.state, stage: { kind: "live" } as const, forwardCheckpoint: checkpoint, gaps: new Map([["42", [{ from: 101, to: "open" as const }]]]) };
  await h.states.upsert({ key: h.workerKey, state: row });
  const clock = new ManualClock(Date.parse("2026-08-12T08:00:02Z"));
  let repository = h.states;
  async function persisted() {
    const state = await repository.get(h.state.key.userId, "telegram", "telegram", h.state.key.accountId);
    if (state === null) throw new Error("native owned state disappeared");
    return state;
  }
  const host = { publish: () => undefined, stampsMoved: () => undefined, replaced: () => undefined };
  const surface = { syncMode: "push" as const, progress: { "telegram.chat": "chats", "telegram.message": "messages" } };
  const createWorker = async () => new SyncWorker(
    h.workerKey, surface, (await persisted()).state, { "telegram.chat": 1, "telegram.message": 0 }, h.router, repository, host, NEVER_PAUSED, clock,
  );
  let worker = await createWorker();
  async function runExpected(kind: "protectLive" | "liveBatch" | "catchUpPage"): Promise<void> {
    const decision = worker.schedule(clock.now()).decision;
    expect(decision?.kind).toBe(kind);
    if (decision === null) throw new Error(`expected scheduled ${kind}`);
    await worker.run(decision);
    const state = await persisted();
    expect(state.state.hold).toBeNull();
    expect(state.state.forwardCheckpoint).toEqual(checkpoint);
  }
  async function admit(id: number, text: string): Promise<void> {
    const envelope = { ...h.message(id, { text }), kind: "live" as const, position: { scope_id: "42", id } };
    delete envelope.identity_key;
    expect(worker.enqueueLive(envelope)).toBe(true);
    await runExpected("liveBatch");
  }
  const messageRows = () => h.rows("SELECT id,source->>'externalId' AS anchor FROM entities WHERE schema_id='telegram.message' AND is_archived IS NOT TRUE ORDER BY 2");
  try {
    // A fresh process acquires the listener and catches up first; the fake Source has no page, so the
    // catch-up is the failure the hold rule prints — this scenario admits live items under it.
    await runExpected("protectLive");
    expect((await persisted()).state.stage).toEqual({ kind: "catchingUp" });
    await admit(102, "New102");
    // A live point trims the open range by itself; the holes below it are not filled.
    expect((await persisted()).state.gaps.get("42")).toEqual([{ from: 101, to: 101 }, { from: 103, to: "open" }]);
    await admit(104, "New104");
    const gaps: IdRange[] = [{ from: 101, to: 101 }, { from: 103, to: 103 }, { from: 105, to: "open" }];
    expect((await persisted()).state.gaps.get("42")).toEqual(gaps);
    const identities = await messageRows();
    expect(identities.map((row) => row["anchor"])).toEqual(["tg:msg:42:102", "tg:msg:42:104"]);
    expect(worker.reported().progress["telegram.message"]?.synced).toBe(2);
    for (const text of ["Edited104", "Edited104"]) {
      await admit(104, text);
      expect(await messageRows()).toEqual(identities);
      expect((await persisted()).state.gaps.get("42")).toEqual(gaps);
    }
    // A re-delivered record is not a second insert: the count stays.
    expect(worker.reported().progress["telegram.message"]?.synced).toBe(2);
    expect(await h.rows("SELECT properties->>'last_message_preview' AS preview FROM entities WHERE source->>'externalId'='tg:chat:42'"))
      .toEqual([{ preview: "Edited104" }]);
    await worker.stop();
    repository = new SyncStateRepository(h.db);
    expect((await persisted()).state.gaps.get("42")).toEqual(gaps);
    worker = await createWorker();
    await runExpected("protectLive");
    await admit(104, "Edited104");
    expect(await messageRows()).toEqual(identities);
    expect((await persisted()).state.gaps.get("42")).toEqual(gaps);
    expect(worker.schedule(clock.now()).decision?.kind).toBe("catchUpPage");
  } finally { await worker.stop(); }
  expect(commands).toEqual(["listen_start", "listen_stop", "listen_start", "listen_stop"]);
}, 60_000);

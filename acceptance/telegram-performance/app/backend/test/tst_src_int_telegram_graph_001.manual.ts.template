async function makeStand(generation = 1, telegram = { directory: "test-e2e/fixtures/channel", pin: fixtureIndex.packages.find((pkg) => pkg.kind === "module" && pkg.id === "telegram") }) {
  const database = await createSourceSyncDatabase();
  const directory = mkdtempSync(join(tmpdir(), "magnis-tg-graph-"));
  let store: ExtensionPackageStore | undefined;
  let runtime: PluginRuntimeService | undefined;
  let files: FileService | undefined;
  let web: WebService | undefined;
  let stopPreview: (() => Promise<void>) | undefined;
  let closed = false;
  async function close(): Promise<void> {
    if (closed) return;
    closed = true;
    try {
      await runtime?.onModuleDestroy();
      await web?.settleEnrichments();
      files?.downloadQueue().close();
      await stopPreview?.();
      await store?.close();
    } finally {
      try { await database.close(); }
      finally { removeWritableTree(directory); }
    }
  }
  try {
    await applySqlxMigrations(pgClientExecutor(database.reader), loadMigrations(MIGRATIONS_DIR));
    const db = drizzle(database.reader, { schema: dbSchema });
    await ensureUser(db, DEFAULT_USER_ID, "Telegram fixture");
    store = await ExtensionPackageStore.open(join(directory, "store"));
    const artifacts: ExtensionArtifact[] = [];
    for (const id of ["companies", "contacts", "file", "telegram"]) {
      const pin = id === "telegram" ? telegram.pin : fixtureIndex.packages.find((pkg) => pkg.kind === "module" && pkg.id === id);
      if (pin === undefined) throw new Error(`missing vendored module ${id}`);
      const archive = readFileSync(join(repositoryRoot, id === "telegram" ? telegram.directory : "test-e2e/fixtures/channel", pin.archive.name));
      if (createHash("sha256").update(archive).digest("hex") !== pin.archive.sha256) {
        throw new Error(`vendored ${id} archive hash mismatch`);
      }
      const channel = writeFixtureArchiveChannel(join(directory, `channel-${id}`), "module", id, pin.version, archive, 2);
      artifacts.push(await store.publish(await store.stage(channel.pkg, { baseUrl: channel.baseUrl, index: channel.index })));
    }
    // `links.kind` is a foreign key into `link_kinds`: the modules' declared
    // kinds and the web contract's are seeded as the host does at install.
    const declaredKinds = [
      ...artifacts.flatMap((artifact) => artifact.manifest.kind === "module" ? artifact.manifest.document.schemas.links.map((link) => link.kind) : []),
      ...webDatasetContract().links.map((link) => link.kind),
    ];
    await seedLinkKinds(db, [...new Set(declaredKinds)]);
    const linkKindRows = await readLinkKinds(db);
    const native = [graphNativeContract(linkKindRows), webDatasetContract()];
    const manifests = artifacts.map((artifact) => {
      if (artifact.manifest.kind !== "module") throw new Error("expected a module artifact");
      return datasetManifestFrom(artifact.manifest.document);
    });
    const schemas = [...artifacts.flatMap(moduleContractSchemas), ...native.flatMap((contract) => contract.schemas)];
    const catalog = WorkspaceContractCatalog.build(manifests, native).withLinkKinds(linkKindRows);
    const graph = createGraphService(db, GraphContractRegistry.fromSnapshot(catalog.linkRegistry(), schemas));
    await registerSchemas(graph, schemas);
    const states = new SyncStateRepository(db);
    const state = newWorkerState(DEFAULT_USER_ID, "telegram", "telegram", "fixture-account", generation);
    await database.reader.query(`INSERT INTO source_accounts
      (id,user_id,source_id,surface,account_id,account_generation,enabled,created_at,updated_at)
      VALUES ($1,$2,$3,$4,$5,$6,TRUE,'2026-01-01T00:00:00Z','2026-01-01T00:00:00Z')`,
      ["fixture-source-account", state.key.userId, state.key.sourceId, state.key.surface, state.key.accountId, generation]);
    await states.upsert(state);
    const workerKey: SourceWorkerKey = state.key;
    const router = new SyncRouter();
    files = new FileService(graph, router, join(directory, "files"), 0, false, NEVER_PAUSED);
    const fileService = files;
    const downloadReceiver = files.takeDownloadReceiver();
    web = new WebService(graph);
    const webService = web;
    const eventBus = standaloneEventBus();
    const hostState: PluginHostState = {
      listSyncStates: (userId) => states.listAll(userId),
      accountSyncState: () => null,
      resetModuleSyncStates: () => Promise.reject(new Error("unexpected reset")),
      requestBackfill: () => Promise.reject(new Error("unexpected backfill")),
      syncRouter: () => router,
      eventBusSend: () => { throw new Error("unexpected host event"); },
      composerPresence: () => { throw new Error("unexpected composer read"); },
      hasRpcHandler: () => false,
      dispatchRpc: () => Promise.reject(new Error("unexpected RPC")),
      pluginForRoute: () => null,
    };
    const search = await createSearchService({
      db, graph, storage: await createSearchIndexRepository(db), provider: new DeterministicProvider(64),
    });
    const unitOfWork = new UnitOfWork(db);
    runtime = new PluginRuntimeService(testConfig({ DATABASE_URL: database.connectionString, STORAGE_DIR: directory }),
      graph, search, fileService, webService,
      testToolService({ check: () => Promise.resolve({ allowed: false, entry: null }) }), unitOfWork, states);
    const telegramArtifact = artifacts.find((artifact) => artifact.id === "telegram");
    if (telegramArtifact === undefined) throw new Error("Telegram artifact missing");
    const descriptor = await runtime.prepareDescriptor(telegramArtifact);
    runtime.activatePrepared(descriptor);
    const controller = new PluginModuleController("telegram", "telegram", "telegram.__sync__", { mode: "none" },
      runtime, eventBus, hostState, descriptor.descriptorHash, new ProviderInterfaceRegistry(),
      { "telegram.chat": "chats", "telegram.message": "messages" });
    let previewRequests = 0;
    setAllowPrivateUrls(true);
    const server = createServer((_request, response) => {
      previewRequests += 1;
      response.setHeader("content-type", "text/html");
      response.end("<html><head><title>Fixture preview</title></head><body>Local fixture</body></html>");
    });
    await new Promise<void>((resolve) => { server.listen(0, "127.0.0.1", resolve); });
    const address = server.address();
    if (address === null || typeof address === "string") throw new Error("preview server has no port");
    let previewClosed = false;
    stopPreview = () => new Promise<void>((resolve) => {
      if (previewClosed) { resolve(); return; }
      previewClosed = true;
      server.close(() => { resolve(); });
    });
    const url = `http://127.0.0.1:${String(address.port)}/page`;
    function envelope(remoteId: string, payload: JsonValue, kind: SourceEnvelope["kind"] = "snapshot"): SourceEnvelope {
      return { source_id: state.key.sourceId, surface: state.key.surface, account_id: state.key.accountId,
        account_generation: state.key.generation, user_id: state.key.userId, identity_key: "9001",
        kind, remote_id: remoteId, payload, timestamp: "2026-08-12T08:00:01Z" };
    }
    function message(id: number, overrides: Record<string, JsonValue> = {}): SourceEnvelope {
      return envelope(`tg:msg:42:${String(id)}`, { chat_id: 42, message_id: id,
        sender_id: 501, sender_name: "Alice", text: `Message ${String(id)}`, date: "2026-08-12T08:00:00Z", is_outgoing: false, ...overrides });
    }
    const chat = (): SourceEnvelope => envelope("tg:chat:42", {
      entity_type: "telegram_chat", chat_id: 42, title: "Preserve this title", type: "private", is_indexed: true,
      is_pinned: false, pin_order: null, unread_count: 0, unread_mark: false,
      read_inbox_max_id: 0, read_outbox_max_id: 0, unread_mentions_count: 0, top_message: 0,
    });
    async function rows(query: string): Promise<Record<string, unknown>[]> {
      return (await database.reader.query<Record<string, unknown>>(query)).rows;
    }
    async function graphIdentity() {
      return { entities: await rows("SELECT id, source->>'externalId' AS anchor, schema_id FROM entities ORDER BY id"),
        links: await rows("SELECT id, from_entity, to_entity, kind FROM links ORDER BY id") };
    }
    async function durableSnapshot() {
      return { entities: await rows("SELECT * FROM entities ORDER BY id"), links: await rows("SELECT * FROM links ORDER BY id"),
        events: await rows("SELECT * FROM events ORDER BY id"),
        state: await states.get(state.key.userId, state.key.surface, state.key.sourceId, state.key.accountId) };
    }
    async function drainDownloads() {
      fileService.downloadQueue().close();
      const requests: { entityId: string }[] = [];
      for (;;) {
        const request = await downloadReceiver.recv();
        if (request === null) return requests;
        requests.push(request);
      }
    }
    const readRuntime = runtime;
    return { reader: database.reader, rows, url, chat, message, envelope, graphIdentity, durableSnapshot, drainDownloads,
      files: fileService, router, db, states, state, workerKey, controller, eventBus, unitOfWork,
      search, graph,
      window: (spec: JsonValue) => opGraphListEntitiesWindow({
        moduleContext: createPluginCapabilityContext(DEFAULT_USER_ID, "module", "telegram", descriptor.capabilities),
        storage: new OpStorage(), graph, search, fileService, webService, hostState,
        syncProvenance: null, syncScope: null, hostOps: new Map<string, number>(), pageReceipt: null, syncStates: states,
        sourceCommandSurfaces: ["telegram"],
      }, spec),
      read: (method: string, params: JsonValue) => readRuntime.dispatch({
        userId: DEFAULT_USER_ID, hostState, syncProvenance: null,
      }, method, params),
      runDownloads: () => runDownloadWorker(fileService, downloadReceiver, NEVER_PAUSED, 0),
      previewRequests: () => previewRequests, settle: () => webService.settleEnrichments(),
      ingest: (envelopes: SourceEnvelope[]) => controller.ingestSourceEvents(envelopes, workerKey, null), close };
  } catch (error) { await close(); throw error; }
}
async function stand(generation = 1, telegram?: Parameters<typeof makeStand>[1]) { active = await makeStand(generation, telegram); return active; }

/**
 * @test-id: tst_src_int_telegram_graph_013
 * @scenario: scn_telegram_targeted_anchor_batch_001
 * @covers: GraphService.findEntityIdsByAnchors, GraphRepository source-key resolution
 * @deterministic: yes; native PostgreSQL and synthetic users
 * @fixtures: owned, foreign, archived, missing and duplicate keys; transaction rollback
 */
test.skipIf(process.env["MAGNIS_SYNC_TEST_DATABASE_URL"] === undefined)("tst_src_int_telegram_graph_013 resolves ordered source-key batches with one scoped native query", async () => {
  const h = await stand();
  await h.ingest([h.chat(), h.message(7), h.message(8)]);
  const stored = await h.reader.query<{ id: string; anchor: string }>("SELECT id, source->>'externalId' AS anchor FROM entities WHERE schema_id IN ('telegram.chat','telegram.message')");
  const ids = new Map(stored.rows.map((row) => [row.anchor, row.id]));
  const chat = ids.get("tg:chat:42");
  const message = ids.get("tg:msg:42:7");
  const archived = ids.get("tg:msg:42:8");
  if (chat === undefined || message === undefined || archived === undefined) throw new Error("native key fixture missing");
  const foreign = "00000000-0000-0000-0000-000000000099";
  await ensureUser(h.db, foreign, "Foreign key owner");
  // The foreign owner holds its own record under the same key, and one key only it holds.
  const foreignChat = "00000000-0000-0000-0000-00000000f001";
  const foreignOnly = "00000000-0000-0000-0000-00000000f002";
  await h.reader.query(`INSERT INTO entities (id,owner,schema_id,schema_version,origin,source,properties)
    VALUES ($1,$2,'telegram.chat',1,'canonical',$3::jsonb,'{}'::jsonb), ($4,$2,'telegram.chat',1,'canonical',$5::jsonb,'{}'::jsonb)`,
    [foreignChat, foreign, JSON.stringify({ source: "telegram", account: "foreign-account", externalId: "tg:chat:42" }),
      foreignOnly, JSON.stringify({ source: "telegram", account: "foreign-account", externalId: "fixture:foreign-only" })]);
  await h.reader.query("UPDATE entities SET is_archived=true WHERE source->>'externalId'='tg:msg:42:8'");
  const reads = spyOn(h.reader, "query");
  try {
    expect(await h.graph.findEntityIdsByAnchors(DEFAULT_USER_ID, [])).toEqual([]);
    expect(reads).toHaveBeenCalledTimes(0);
    // An archived record keeps its key: a re-sync lands on it, never on a copy.
    expect(await h.graph.findEntityIdsByAnchors(DEFAULT_USER_ID,
      ["tg:chat:42", "fixture:missing", "tg:msg:42:7", "tg:chat:42", "fixture:foreign-only", "tg:msg:42:8"]))
      .toEqual([chat, null, message, chat, null, archived]);
    expect(reads).toHaveBeenCalledTimes(1);
    // The key is the owner's: the foreign owner resolves its own records, never ours.
    expect(await h.graph.findEntityIdsByAnchors(foreign, ["fixture:foreign-only", "tg:chat:42", "tg:msg:42:7"]))
      .toEqual([foreignOnly, foreignChat, null]);
    expect(reads).toHaveBeenCalledTimes(2);
  } finally { reads.mockRestore(); }
  await expect(h.unitOfWork.run(async (scope) => {
    await UnitOfWork.connection(scope).execute(sql`INSERT INTO entities (id,owner,schema_id,schema_version,origin,source,properties)
      VALUES ('00000000-0000-0000-0000-00000000f003',${DEFAULT_USER_ID},'telegram.chat',1,'canonical',
        ${JSON.stringify({ source: "telegram", account: "fixture-account", externalId: "fixture:scoped-only" })}::jsonb,'{}'::jsonb)`);
    expect(await h.graph.forScope(scope).findEntityIdsByAnchors(DEFAULT_USER_ID, ["fixture:scoped-only"]))
      .toEqual(["00000000-0000-0000-0000-00000000f003"]);
    throw new Error("native scope rollback");
  })).rejects.toThrow("native scope rollback");
  expect(await h.graph.findEntityIdsByAnchors(DEFAULT_USER_ID, ["fixture:scoped-only"])).toEqual([null]);
}, 30_000);

/**
 * @test-id: tst_src_int_telegram_graph_012
 * @scenario: scn_telegram_account_message_progress_001
 * @covers: EntityRepository.countSourceEntities, GraphService.countSourceEntities
 * @deterministic: yes; fixed account/Source envelopes and native PostgreSQL
 * @fixtures: real Telegram receiver, a record re-delivered by a second account, archive, rollback
 */
test.skipIf(process.env["MAGNIS_SYNC_TEST_DATABASE_URL"] === undefined)("tst_src_int_telegram_graph_012 saved counts follow the record's stamp across replay, re-delivery and rollback", async () => {
  const h = await stand();
  const count = (account = "fixture-account", user = DEFAULT_USER_ID) => h.graph.countSourceEntities(
    user, "telegram.message", { source: "telegram", account, surface: "telegram" },
  );
  await h.ingest([h.chat(), h.message(7), h.message(8)]);
  expect(await count()).toBe(2);
  await h.ingest([h.chat(), h.message(7), h.message(8)]);
  expect(await count()).toBe(2);
  expect(await count("second-account")).toBe(0);

  await h.reader.query(`INSERT INTO source_accounts
    (id,user_id,source_id,surface,account_id,account_generation,enabled,created_at,updated_at)
    VALUES ('second-source-account',$1,'telegram','telegram','second-account',1,TRUE,
      '2026-01-01T00:00:00Z','2026-01-01T00:00:00Z')`, [DEFAULT_USER_ID]);
  const secondKey = { ...h.workerKey, accountId: "second-account", syncRowId: "second-sync-state" };
  await h.states.upsert({ key: secondKey, state: h.state.state });
  // The second account's page states what it stamped and whose stamp it took:
  // the worker moves its own synced by `inserted`, the sibling's by `moved`.
  const page: SyncPageAdmission = { receipt: { progress: {}, moved: {}, excluded: [] }, apply: () => h.state.state };
  await h.controller.ingestSourceEvents([h.chat(), h.message(7)].map((envelope) => ({
    ...envelope, account_id: "second-account",
  })), secondKey, page);
  expect(page.receipt.progress["telegram.message"]).toMatchObject({ inserted: 1, removed: 0 });
  // Every schema the page re-stamped is reported; the workers keep the ones they declare.
  expect(page.receipt.moved["fixture-account"]).toMatchObject({ "telegram.message": 1, "telegram.chat": 1 });
  // The owner's record under a key is one row whoever delivered it: the
  // latest delivery's stamp names the account it is counted for.
  expect(await count()).toBe(1);
  expect(await count("second-account")).toBe(1);
  expect(await h.rows("SELECT count(*)::int AS count FROM entities WHERE schema_id='telegram.message'")).toEqual([{ count: 2 }]);

  await ensureUser(h.db, "progress-foreign-user", "Count isolation");
  await h.reader.query(`INSERT INTO entities (id,owner,schema_id,schema_version,origin,source,properties)
    VALUES ('00000000-0000-4000-8000-000000000003','progress-foreign-user','telegram.message',1,'canonical',$1::jsonb,'{}')`,
  [JSON.stringify({ source: "telegram", account: "fixture-account", externalId: "fixture:foreign" })]);
  expect(await count()).toBe(1); // Another owner's record under the same account is not this owner's.
  expect(await count("fixture-account", "progress-foreign-user")).toBe(1);
  await h.reader.query(`UPDATE entities SET is_archived=TRUE WHERE source->>'externalId'='tg:msg:42:8'`);
  expect(await count()).toBe(0);
  expect(await count("second-account")).toBe(1);

  await h.reader.query(`CREATE SEQUENCE fixture_count_rollbacks;
    CREATE FUNCTION fixture_reject_count_page() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN IF NEW.source->>'externalId'='tg:msg:42:10' THEN
      PERFORM nextval('fixture_count_rollbacks'); RAISE EXCEPTION 'fixture count rollback'; END IF;
    RETURN NEW; END $$;
    CREATE TRIGGER fixture_reject_count_page BEFORE INSERT ON entities
      FOR EACH ROW EXECUTE FUNCTION fixture_reject_count_page();`);
  await expect(h.ingest([h.message(9), h.message(10)])).rejects.toThrow();
  expect(await h.rows("SELECT is_called FROM fixture_count_rollbacks")).toEqual([{ is_called: true }]);
  expect(await count()).toBe(0);
}, 60_000);

/**
 * @test-id: tst_src_int_telegram_graph_009
 * @scenario: scn_telegram_large_dialog_list_001
 * @covers: actual module observer reads and native Graph traversal admission
 * @deterministic: yes; stable IDs and synthetic graph rows only
 * @fixtures: exact Telegram module; 5001 canonical message-to-chat links
 */
test.skipIf(process.env["MAGNIS_SYNC_TEST_DATABASE_URL"] === undefined)("tst_src_int_telegram_graph_009 large pinned chat reads do not traverse message history", async () => {
  const h = await stand(1, { directory: "test-e2e/fixtures/telegram-unicode", pin: unicodeTelegram });
  await h.ingest([h.envelope("tg:chat:42", {
    entity_type: "telegram_chat", chat_id: 42, title: "Dense history",
    is_pinned: true, pin_order: 2,
  })]);
  const chat = (await h.rows("SELECT id FROM entities WHERE source->>'externalId'='tg:chat:42'"))[0];
  if (typeof chat?.id !== "string") throw new Error("Fixture chat missing");
  // Populate the real read boundary without making5001 provider or host calls.
  await h.reader.query(`WITH seeded AS (
    INSERT INTO entities (id,owner,schema_id,schema_version,name,origin,source,idx,properties)
    SELECT md5('dense-message-'||n)::uuid::text,$1,'telegram.message',1,'Fixture message','canonical',
      jsonb_build_object('source','telegram','account','fixture-account','externalId','fixture:dense-message:'||n),
      '42',jsonb_build_object('chat_id',42,'message_id',n)
    FROM generate_series(1,5001) n RETURNING id,owner
  )
  INSERT INTO links (id,owner,from_entity,to_entity,kind,origin)
  SELECT md5('dense-edge-'||id)::uuid::text,owner,id,$2,'in_chat','canonical' FROM seeded`, [DEFAULT_USER_ID, chat.id]);
  expect(await h.rows("SELECT count(*)::int AS count FROM links WHERE kind='in_chat'"))
    .toEqual([{ count: 5001 }]);
  const item = { entity_id: chat.id, is_pinned: true, pin_order: 2 };
  expect(await h.read("telegram.chats.list", { limit: 50, offset: 0 }))
    .toMatchObject({ total: 1, items: [expect.objectContaining(item)] });
  expect(await h.read("telegram.chats.get", { entity_id: chat.id })).toMatchObject(item);
  // Retrieval needs an explicit declaration and the real indexer, as in production.
  const plan = fixtureEmbedPlan();
  plan.read().insert("telegram.chat", [["title"]], []);
  h.search.withEmbedPlan(plan);
  const indexer = await createSearchIndexer(
    h.db, await createSearchIndexRepository(h.db), new DeterministicProvider(64), 100, plan,
  );
  await indexer.runUntilIdle();
  expect(await h.read("telegram.chats.list", { search: "Dense", limit: 50, offset: 0 }))

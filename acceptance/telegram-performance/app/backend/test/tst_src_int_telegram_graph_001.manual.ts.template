      source_ref: { ...sourceRef, account_generation: 7 }, dest: join(h.files.filesDir(), sourceRef.dest_subpath) });
    writeFileSync(join(h.files.filesDir(), sourceRef.dest_subpath), bytes);
    return Promise.resolve({ size_bytes: bytes.length, local_path: sourceRef.dest_subpath });
  });

/**
 * @test-id: tst_src_int_telegram_graph_007
 * @scenario: scn_telegram_large_snapshot_atomic_001
 * @covers: worker-admitted Telegram snapshots, real host frames and one native Graph transaction
 * @deterministic: yes; synthetic Telegram-shaped UTF-8 messages, no provider calls
 * @fixtures: Source chatPayload/messagePayload wire (telegram_chat and absent message entity_type)
 */
test.skipIf(process.env["MAGNIS_SYNC_TEST_DATABASE_URL"] === undefined)("tst_src_int_telegram_graph_007 large snapshot frames commit once, roll back a late chunk and replay exactly", async () => {
  const h = await stand();
  await h.ingest([h.chat()]);
  const dispatch = spyOn(PluginHostClient.prototype, "dispatch");
  const dispatches = () => dispatch.mock.calls.filter(([, method]) => method === "telegram.__sync__")
    .map(([, , params]) => {
      if (params === null || typeof params !== "object" || Array.isArray(params) || !Array.isArray(params.envelopes)) {
        throw new Error("expected real legacy snapshot request");
      }
      return { count: params.envelopes.length, bytes: Buffer.byteLength(JSON.stringify(params)) };
    });
  const transaction = spyOn(h.unitOfWork, "run");
  const page = (start: number) => Array.from({ length: 180 }, (_, index) => h.message(start + index, {
    text: index < 70 ? "😀".repeat(4096) : `Short snapshot ${String(start + index)}`,
  }));
  try {
    const first = [h.chat(), ...page(1)];
    expect(Buffer.byteLength(JSON.stringify(first))).toBeGreaterThan(1024 * 1024);
    await expect(h.ingest(first)).resolves.toEqual({ dropped_remote_ids: [], trigger_checks: [] });
    expect(transaction).toHaveBeenCalledTimes(1);
    expect(dispatches().length).toBeGreaterThan(1);
    expect(dispatches().some(({ count }) => count === 50)).toBe(true);
    expect(dispatches().every(({ count, bytes }) => count <= 50 && bytes <= 64 * 1024)).toBe(true);
    expect(await h.rows("SELECT count(*)::int AS count FROM entities WHERE schema_id='telegram.message'"))
      .toEqual([{ count: 180 }]);
    const identity = await h.graphIdentity();
    await h.ingest(first);
    expect(await h.graphIdentity()).toEqual(identity);

    const before = await h.durableSnapshot();
    await h.reader.query(`CREATE SEQUENCE fixture_large_page_attempts;
      CREATE FUNCTION fixture_reject_large_tail() RETURNS trigger LANGUAGE plpgsql AS $$
      BEGIN
        IF NEW.schema_id='telegram.message' THEN PERFORM nextval('fixture_large_page_attempts'); END IF;
        IF NEW.source->>'externalId'='tg:msg:42:379' THEN RAISE EXCEPTION 'fixture large tail refused'; END IF;
        RETURN NEW;
      END $$;
      CREATE TRIGGER fixture_reject_large_tail BEFORE INSERT ON entities
        FOR EACH ROW EXECUTE FUNCTION fixture_reject_large_tail();`);
    const second = page(200);
    second[0] = h.message(200, { text: `Deferred preview ${h.url}` });
    transaction.mockClear();
    await expect(h.ingest(second)).rejects.toThrow("apply_batch");
    expect(transaction).toHaveBeenCalledTimes(1);
    expect(await h.rows("SELECT last_value = 180 AS prefix_attempted FROM fixture_large_page_attempts"))
      .toEqual([{ prefix_attempted: true }]);
    await h.settle();
    expect(h.previewRequests()).toBe(0);
    expect(await h.durableSnapshot()).toEqual(before);
    await h.reader.query("DROP TRIGGER fixture_reject_large_tail ON entities");
    await h.ingest(second);
    await h.settle();
    expect(await h.rows("SELECT count(*)::int AS count FROM entities WHERE schema_id='telegram.message'"))
      .toEqual([{ count: 360 }]);
    const recovered = await h.graphIdentity();
    await h.ingest(second);
    expect(await h.graphIdentity()).toEqual(recovered);
    transaction.mockClear();
    await expect(h.ingest([h.message(9999, { text: "x".repeat(64 * 1024) })]))
      .rejects.toThrow("admission budget");
    expect(transaction).not.toHaveBeenCalled();
    expect(await h.graphIdentity()).toEqual(recovered);
    // Mixed deletion/message ordering belongs to the existing receiver, not the splitter.
    dispatch.mockClear();
    await h.ingest([h.message(500), h.envelope("tg:msg:42:500", {}, "delete")]);
    expect(dispatches()).toHaveLength(1);
    expect(await h.rows("SELECT is_archived IS TRUE AS archived FROM entities WHERE source->>'externalId'='tg:msg:42:500'"))
      .toEqual([{ archived: false }]);
  } finally { transaction.mockRestore(); dispatch.mockRestore(); }
}, 60_000);

/**
 * @test-id: tst_src_int_telegram_graph_010
 * @scenario: scn_telegram_long_url_atomic_001
 * @covers: actual Telegram module, WebService and native Graph anchor admission
 * @deterministic: yes; generated hash text and local preview HTTP, no provider
 * @fixtures: retained native Graph stand with a50-message provider-shaped page
 */
test.skipIf(process.env["MAGNIS_SYNC_TEST_DATABASE_URL"] === undefined)("tst_src_int_telegram_graph_010 long URLs retain identity across native batch admission and replay", async () => {
  const h = await stand();
  await h.ingest([h.chat()]);
  const suffix = Array.from({ length: 60 }, (_, index) => createHash("sha256")
    .update(`long-url-fixture-${String(index)}`).digest("hex")).join("");
  const url = `${h.url}?payload=${suffix}`;
  expect(Buffer.byteLength(`web:link:${url}`)).toBeGreaterThan(3800);
  const body = `Complete link ${url}`;
  const page = Array.from({ length: 50 }, (_, index) => h.message(index + 1,
    index === 24 ? { text: body } : {}));
  await expect(h.ingest(page)).resolves.toEqual({ dropped_remote_ids: [], trigger_checks: [] });
  await h.settle();
  const links = await h.reader.query(`SELECT e.id, e.source->>'externalId' AS anchor, e.properties->>'url' AS url
    FROM entities e JOIN links l ON l.to_entity=e.id
    JOIN entities m ON m.id=l.from_entity
    WHERE m.source->>'externalId'='tg:msg:42:25' AND l.kind='references'`);
  expect(links.rows).toMatchObject([{ anchor: `web:link:${url}`, url }]);
  expect(await h.rows("SELECT count(*)::int AS count FROM entities WHERE schema_id='telegram.message'"))
    .toEqual([{ count: 50 }]);
  expect(await h.rows("SELECT properties->>'text' AS text FROM entities WHERE source->>'externalId'='tg:msg:42:25'"))
    .toEqual([{ text: body }]);
  const identity = await h.graphIdentity();
  const requests = h.previewRequests();
  await h.ingest(page);
  await h.settle();
  expect(await h.graphIdentity()).toEqual(identity);
  expect(h.previewRequests()).toBe(requests);
  // A shared prefix is not identity: never truncate the long tail to fit an index.
  const secondUrl = `${url}different`;
  await h.ingest([h.message(51, { text: secondUrl })]);
  await h.settle();
  expect((await h.reader.query("SELECT source->>'externalId' AS anchor FROM entities WHERE schema_id='web.link' ORDER BY 1")).rows)
    .toEqual([{ anchor: `web:link:${url}` }, { anchor: `web:link:${secondUrl}` }]);
  const before = await h.durableSnapshot();
  await h.reader.query(`CREATE FUNCTION fixture_long_url_tail_failure() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN IF NEW.source->>'externalId'='tg:msg:42:53' THEN RAISE EXCEPTION 'fixture late message failure'; END IF;
    RETURN NEW; END $$;
    CREATE TRIGGER fixture_long_url_tail_failure BEFORE INSERT ON entities
    FOR EACH ROW EXECUTE FUNCTION fixture_long_url_tail_failure()`);
  await expect(h.ingest([h.message(52, { text: `${url}rollback` }), h.message(53)]))
    .rejects.toThrow("apply_batch");
  await h.settle();
  expect(await h.durableSnapshot()).toEqual(before);
}, 60_000);


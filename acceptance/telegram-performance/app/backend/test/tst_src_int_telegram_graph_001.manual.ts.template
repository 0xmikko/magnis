/**
 * @test-id: tst_src_int_telegram_graph_006
 * @scenario: scn_telegram_chat_read_001
 * @covers: real Telegram chats.list → graph window → Search → native PostgreSQL
 * @deterministic: yes; fixed chat/observer metadata, no provider connection
 */
test.skipIf(process.env["MAGNIS_SYNC_TEST_DATABASE_URL"] === undefined)("tst_src_int_telegram_graph_006 real chat windows retain observer pins, absent metadata and tenant isolation", async () => {
  const h = await stand();
  const chats = [
    { id: 11, is_pinned: true, pin_order: 10 },
    { id: 12, is_pinned: true, pin_order: 2 },
    { id: 13, is_pinned: false },
    { id: 14 }, // Canonical membership without pin metadata.
    { id: 15 }, // Membership removed below: no edge is not a pin.
    { id: 16, is_pinned: true, pin_order: 0 }, // Decayed below.
    { id: 17, is_pinned: true, pin_order: 0 }, // Archived below.
    { id: 18 }, // Another observer's pin must not become ours.
  ];
  await h.ingest(chats.map(({ id, ...metadata }) => h.envelope(`tg:chat:${String(id)}`, {
    entity_type: "chat", chat_id: id, title: `Fixture ${String(id)}`, type: "private",
    last_message_date: `2026-08-${String(id)}T08:00:00Z`, ...metadata,
  })));
  // Only this test-owned database is modified; the module read and all Graph/Search IO stay real.
  await h.reader.query(`DELETE FROM links WHERE to_entity=(SELECT id FROM entities WHERE source->>'externalId'='tg:chat:15');
    UPDATE links SET metadata='{"is_pinned":null}'::jsonb WHERE to_entity=(SELECT id FROM entities WHERE source->>'externalId'='tg:chat:14');
    UPDATE links SET origin='agent', confidence=0.5, evidence=ARRAY[to_entity]::text[]
      WHERE to_entity=(SELECT id FROM entities WHERE source->>'externalId'='tg:chat:16');
    UPDATE entities SET is_archived=TRUE WHERE source->>'externalId'='tg:chat:17';
    INSERT INTO entities (id,owner,schema_id,schema_version,origin,source,properties)
      SELECT '00000000-0000-0000-0000-000000009002',owner,schema_id,schema_version,'canonical',
        jsonb_build_object('source','telegram','account','fixture-account','externalId','tg:account:9002'),
        '{"telegram_user_id":9002,"is_self":false}'::jsonb
      FROM entities WHERE schema_id='telegram.account';
    INSERT INTO links (id,owner,from_entity,to_entity,kind,origin,metadata)
      SELECT '00000000-0000-0000-0000-000000009003',owner,
        '00000000-0000-0000-0000-000000009002',id,'observed_in','canonical','{"is_pinned":true,"pin_order":0}'::jsonb
      FROM entities WHERE source->>'externalId'='tg:chat:18';`);
  const otherUser = "00000000-0000-0000-0000-000000009004";
  await ensureUser(h.db, otherUser, "Other fixture");
  await h.reader.query(`INSERT INTO entities (id,owner,schema_id,schema_version,origin,source,properties)
    SELECT '00000000-0000-0000-0000-000000009005',$1,schema_id,schema_version,'canonical',source,properties
    FROM entities WHERE source->>'externalId'='tg:chat:11'`, [otherUser]);

  function pageIds(value: JsonValue): string[] {
    if (value === null || typeof value !== "object" || Array.isArray(value) || !Array.isArray(value.items)) {
      throw new Error("expected a chat page");
    }
    return value.items.map((item) => {
      if (item === null || typeof item !== "object" || Array.isArray(item) || typeof item.chat_id !== "string") {
        throw new Error("expected a chat identity");
      }
      return item.chat_id;
    });
  }
  const before = await h.graphIdentity();
  const all = await h.read("telegram.chats.list", { limit: 50, offset: 0 });
  expect(all).toMatchObject({ total: 7, limit: 50, offset: 0 });
  // This pinned artifact uses legacy TEXT edge ordering (10 before 2; false before NULL).
  expect(pageIds(all)).toEqual(["11", "12", "13", "18", "16", "15", "14"]);
  const pages: string[] = [];
  for (const offset of [0, 2, 4, 6, 8]) {
    const page = await h.read("telegram.chats.list", { limit: 2, offset });
    expect(page).toMatchObject({ total: 7, limit: 2, offset });
    pages.push(...pageIds(page));
  }
  expect(pages).toEqual(pageIds(all));
  expect(new Set(pages).size).toBe(7);
  const observer = (await h.rows("SELECT source->>'externalId' AS anchor FROM entities WHERE properties->>'is_self'='true'"))[0]?.anchor;
  if (typeof observer !== "string") throw new Error("fixture observer anchor missing");
  const pinFilter = { edge_kind: "observed_in", observer_anchor: observer, edge_path: "is_pinned" };
  expect(await h.window({ schema: "telegram.chat", filter_field: pinFilter,
    filter_op: "exists", filter_eq: "", limit: 50, offset: 0 })).toMatchObject({ total: 3 });
  expect(await h.window({ schema: "telegram.chat", filter_field: pinFilter,
    filter_op: "distinct", filter_eq: "true", limit: 50, offset: 0 })).toMatchObject({ total: 5 });
  const target = { kind: "edge_meta" as const, link_kind: "observed_in", observer_anchor: observer, path: "pin_order" };
  // Explicit Search order flags stay authoritative: textual 10<2, numeric 2<10.
  // Each full page must carry its actual SQL scalar/null into the next query.
  for (const numeric of [false, true]) {
    for (const nullsLast of [false, true]) {
      const spec: SearchSpec = {
        userId: DEFAULT_USER_ID, schemaId: "telegram.chat", fields: [], collections: [], links: [],
        semantic: null, order: [{ target, numeric, nullsLast, desc: false }], idDesc: false,
        limit: 2, after: null, count: { mode: "exact" }, showArchived: false,
      };
      const anchors: (string | null)[] = [];
      const keys: JsonValue[] = [];
      for (let pageNumber = 0; pageNumber < 5; pageNumber += 1) {
        const page = await h.search.search({ kind: "declared", spec, retrieval: null });
        expect(page.total).toBe(7);
        anchors.push(...page.items.map((entity) => entity.origin === "canonical" ? entity.source.externalId : null));
        if (page.next === null) break;
        expect(page.next.keys).toHaveLength(1);
        keys.push(...page.next.keys);
        spec.after = page.next;
      }
      expect(anchors).toHaveLength(7);
      expect(new Set(anchors)).toEqual(new Set([11, 12, 13, 14, 15, 16, 18].map((id) => `tg:chat:${String(id)}`)));
      const pinned = numeric ? ["tg:chat:12", "tg:chat:11"] : ["tg:chat:11", "tg:chat:12"];
      expect(nullsLast ? anchors.slice(0, 2) : anchors.slice(-2)).toEqual(pinned);
      expect(keys).toContain(null);
      expect(keys).toContain(nullsLast ? (numeric ? "10" : "2") : (numeric ? "2" : "10"));
    }
  }
  const window = { schema: "telegram.chat", filter_field: {
    edge_kind: "observed_in", observer_anchor: observer, edge_path: "is_pinned",
  }, filter_op: "eq", filter_eq: "true", limit: 1, offset: 1,
  order: [{ field: { edge_kind: "observed_in", observer_anchor: observer, edge_path: "pin_order" }, desc: false }] };
  expect(await h.window(window)).toMatchObject({ total: 2, items: [{ entity: { anchor: "tg:chat:12" } }] });
  await expect(h.window({ ...window, filter_field: { ...window.filter_field, edge_kind: "undeclared.fixture" } }))
    .rejects.toThrow("declared Search relation");
  expect(await h.graphIdentity()).toEqual(before);
}, 60_000);

